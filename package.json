{
  "name": "progressbrief",
  "version": "0.0.0",
  "description": "Turn work evidence into concise, evidence-aware HTML reports.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "progressbrief": "./dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:foundation",
    "test:contracts": "npm run build --silent && node --test tests/contracts/*.test.mjs",
    "test:browser": "npm run build --silent && node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "test:foundation": "npm run build --silent && node --test tests/foundation/*.test.mjs",
    "test:library": "npm run build --silent && node --test --test-concurrency=1 tests/library/*.test.mjs",
    "test:recall": "npm run build --silent && node --test --test-concurrency=1 tests/recall/*.test.mjs",
    "test:report": "npm run build --silent && node --test tests/report/*.test.mjs",
    "test:review": "npm run build --silent && node --test --test-concurrency=1 tests/review/*.test.mjs",
    "validate:ci": "node scripts/validate-ci.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "verify:gate": "node scripts/verify-gate.mjs",
    "verify": "node scripts/verify-gate.mjs 10"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "playwright": "1.57.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "sharp": "0.35.4",
    "yaml": "^2.9.0"
  }
}
